# AI-BugHunter Environment Configuration

# Application Environment (development, testing, production)
APP_ENV=development

# Database
# In production, use a PostgreSQL database. E.g., postgresql://user:pass@localhost/dbname
DATABASE_URL=sqlite:///./bughunter.db

# Security & Crypto
# This key is REQUIRED in production. Generate a 32-byte url-safe base64-encoded key.
AUTH_BANK_ENCRYPTION_KEY=

# CORS Configuration
# Comma-separated list of allowed origins. Do NOT use * in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Providers
# Options: mock, openai, anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Target Fixture
# Explicitly allow local test fixture domains for SSRF defense exceptions.
TEST_FIXTURE_URL=http://127.0.0.1:9000
